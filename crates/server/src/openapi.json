          "ignored_by_token": {
            "type": [
              "string",
              "null"
            ],
            "description": "The token that ignored the finding from a VEX document, while it is ignored."
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            },
