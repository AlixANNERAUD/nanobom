{
  "openapi": "3.1.0",
  "info": {
    "title": "nanobom read API",
    "version": "1",
    "description": "Read what nanobom knows about organizations, projects, findings, components and runs. Every endpoint is read-only and checks access as the interface does: anything out of the caller's reach is 404, like something missing. Changes are additive (new endpoints, query parameters and response fields), so clients must ignore fields they do not know; see the guide for the stability promise."
  },
  "externalDocs": {
    "description": "Read API reference",
    "url": "https://alixanneraud.github.io/nanobom/reference/read-api.html"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearer": []
    },
    {
      "apiKey": []
    },
    {
      "session": []
    }
  ],
  "tags": [
    {
      "name": "read",
      "description": "Read-only endpoints."
    }
  ],
  "paths": {
    "/api/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "summary": "This description",
        "description": "The OpenAPI description of the read API. It needs no authentication.",
        "tags": [
          "read"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "This document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/organizations": {
      "get": {
        "operationId": "listOrganizations",
        "summary": "Organizations",
        "description": "The organizations the caller sees, by name. A token sees its own organization.",
        "tags": [
          "read"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "The organizations.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationList"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/organizations/{organization}/projects": {
      "get": {
        "operationId": "listProjects",
        "summary": "Projects",
        "description": "The organization's projects by slug, with their open findings by severity. A project token sees its project only.",
        "tags": [
          "read"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          },
          {
            "$ref": "#/components/parameters/Organization"
          }
        ],
        "responses": {
          "200": {
            "description": "The projects.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectList"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/organizations/{organization}/projects/{project}/findings": {
      "get": {
        "operationId": "listFindings",
        "summary": "Findings of a project",
        "description": "The project's findings in the project page's order: known exploited first, then by severity, EPSS score, CVSS score, component and vulnerability.",
        "tags": [
          "read"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          },
          {
            "$ref": "#/components/parameters/Organization"
          },
          {
            "$ref": "#/components/parameters/Project"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "open",
            "description": "`all`, or a comma-separated list of `open`, `ignored` and `fixed`. Without it, open and ignored findings, as on the project page."
          },
          {
            "name": "severity",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "critical,high",
            "description": "A comma-separated list of `critical`, `high`, `medium`, `low` and `unknown`."
          },
          {
            "name": "exploited",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "description": "`true` for findings with a known exploited CVE only."
          },
          {
            "name": "ecosystem",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Only findings of this ecosystem: the package URL type (`npm`, `cargo`, `pypi`...)."
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of findings.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindingPage"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          }
        }
      }
    },
    "/api/organizations/{organization}/projects/{project}/components": {
      "get": {
        "operationId": "listComponents",
        "summary": "Components of a project",
        "description": "The project's components from its latest SBOM, by package URL.",
        "tags": [
          "read"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          },
          {
            "$ref": "#/components/parameters/Organization"
          },
          {
            "$ref": "#/components/parameters/Project"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of components.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComponentPage"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          }
        }
      }
    },
    "/api/organizations/{organization}/runs": {
      "get": {
        "operationId": "listRuns",
        "summary": "Recent runs",
        "description": "The latest runs that covered the organization (whole-instance runs, and runs of the organization or one of its projects), newest first. A project token sees whole-instance runs and runs of its project. Errors of whole-instance runs are shown to instance administrators only.",
        "tags": [
          "read"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          },
          {
            "$ref": "#/components/parameters/Organization"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "How many runs, from 1 to 100.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The runs.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunList"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          }
        }
      }
    },
    "/api/findings/{finding}": {
      "get": {
        "operationId": "getFinding",
        "summary": "One finding",
        "description": "A finding with its vulnerability, history, dependency paths and the other projects it affects.",
        "tags": [
          "read"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          },
          {
            "name": "finding",
            "in": "path",
            "required": true,
            "description": "The finding's `id`.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The finding.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindingDetail"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/components": {
      "get": {
        "operationId": "searchComponents",
        "summary": "Search components",
        "description": "Components whose name contains `q`, across the projects the caller sees, by name then version, at most 200.",
        "tags": [
          "read"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          },
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "lodash@4.17",
            "description": "A name (`openssl`), optionally followed by a space or `@` and a version prefix (`openssl 3.`)."
          }
        ],
        "responses": {
          "200": {
            "description": "The matching components.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComponentMatchList"
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "A token of either scope (upload or read), from the organization's settings or `nanobom token create`."
      },
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "The same token, in the header Dependency-Track clients use."
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "nanobom_session",
        "description": "The interface's session, for pages of the same instance."
      }
    },
    "parameters": {
      "Organization": {
        "name": "organization",
        "in": "path",
        "required": true,
        "description": "Organization slug.",
        "schema": {
          "type": "string"
        }
      },
      "Project": {
        "name": "project",
        "in": "path",
        "required": true,
        "description": "Project slug.",
        "schema": {
          "type": "string"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "description": "Items per page, from 1 to 500.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100
        }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "description": "Items to skip.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "IfNoneMatch": {
        "name": "If-None-Match",
        "in": "header",
        "description": "The `ETag` of an earlier response: `304` while the data is unchanged.",
        "schema": {
          "type": "string"
        }
      }
    },
    "headers": {
      "ETag": {
        "description": "A weak validator of the response body.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "NotModified": {
        "description": "The data still matches `If-None-Match`."
      },
      "Unauthorized": {
        "description": "No valid token, and no session.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Missing, or out of the caller's reach.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Invalid": {
        "description": "An invalid query parameter.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "What went wrong, in English."
          }
        },
        "required": [
          "error"
        ]
      },
      "Organization": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "viewer",
              "member",
              "admin",
              "owner"
            ],
            "description": "The caller's role. Tokens read as viewers; instance administrators are owners everywhere."
          }
        },
        "required": [
          "slug",
          "name",
          "role"
        ]
      },
      "SeverityCounts": {
        "type": "object",
        "properties": {
          "critical": {
            "type": "integer",
            "minimum": 0
          },
          "high": {
            "type": "integer",
            "minimum": 0
          },
          "medium": {
            "type": "integer",
            "minimum": 0
          },
          "low": {
            "type": "integer",
            "minimum": 0
          },
          "unknown": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "critical",
          "high",
          "medium",
          "low",
          "unknown"
        ]
      },
      "Project": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "last_upload_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The latest SBOM upload; null before the first one."
          },
          "stale": {
            "type": "boolean",
            "description": "No SBOM for longer than the stale threshold (NANOBOM_STALE_AFTER_DAYS)."
          },
          "open": {
            "$ref": "#/components/schemas/SeverityCounts"
          },
          "ignored": {
            "type": "integer",
            "minimum": 0,
            "description": "Ignored findings."
          },
          "known_exploited": {
            "type": "integer",
            "minimum": 0,
            "description": "Open findings with a CVE in the CISA KEV catalog."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The project's page in the interface."
          }
        },
        "required": [
          "slug",
          "name",
          "last_upload_at",
          "stale",
          "open",
          "ignored",
          "known_exploited",
          "url"
        ]
      },
      "Component": {
        "type": "object",
        "properties": {
          "purl": {
            "type": "string",
            "description": "Package URL."
          },
          "name": {
            "type": "string",
            "description": "Package name, with its namespace when it has one."
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "ecosystem": {
            "type": "string",
            "description": "The package URL type (`npm`, `cargo`, `pypi`...)."
          }
        },
        "required": [
          "purl",
          "name",
          "version",
          "ecosystem"
        ]
      },
      "ComponentRef": {
        "type": "object",
        "properties": {
          "purl": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "purl",
          "name",
          "version"
        ]
      },
      "ComponentMatch": {
        "type": "object",
        "properties": {
          "organization": {
            "type": "string",
            "description": "Organization slug."
          },
          "project": {
            "type": "string",
            "description": "Project slug."
          },
          "purl": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "ecosystem": {
            "type": "string",
            "description": "The package URL type (`npm`, `cargo`, `pypi`...)."
          }
        },
        "required": [
          "organization",
          "project",
          "purl",
          "name",
          "version",
          "ecosystem"
        ]
      },
      "Exploitation": {
        "type": "object",
        "properties": {
          "known_exploited": {
            "type": "boolean",
            "description": "A CVE of the finding is in the CISA KEV catalog."
          },
          "kev_date_added": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "kev_due_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "kev_ransomware": {
            "type": "boolean",
            "description": "CISA lists the CVE as used in ransomware campaigns."
          },
          "epss_score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1,
            "description": "Probability of exploitation in the next 30 days (FIRST EPSS)."
          },
          "epss_percentile": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "epss_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        },
        "required": [
          "known_exploited",
          "kev_date_added",
          "kev_due_date",
          "kev_ransomware",
          "epss_score",
          "epss_percentile",
          "epss_date"
        ],
        "description": "Aggregated over the finding's CVEs; empty when nothing is known."
      },
      "Ignore": {
        "type": "object",
        "properties": {
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "justification": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "code_not_present",
              "code_not_reachable",
              "requires_configuration",
              "requires_dependency",
              "requires_environment",
              "protected_by_compiler",
              "protected_at_runtime",
              "protected_at_perimeter",
              "protected_by_mitigating_control",
              "false_positive",
              null
            ]
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "reason",
          "justification",
          "expires_at"
        ]
      },
      "Finding": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "project": {
            "type": "string",
            "description": "Project slug."
          },
          "vulnerability_id": {
            "type": "string",
            "description": "The OSV identifier (GHSA-..., CVE-..., RUSTSEC-...)."
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "component": {
            "$ref": "#/components/schemas/Component"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "unknown"
            ],
            "description": "The highest severity among the vulnerability's aliases."
          },
          "cvss_score": {
            "type": [
              "number",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "ignored",
              "fixed"
            ]
          },
          "exploitation": {
            "$ref": "#/components/schemas/Exploitation"
          },
          "introduced_via": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ComponentRef"
            },
            "description": "The project's direct dependencies that lead to the component; empty when the SBOM's dependency graph does not say."
          },
          "first_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "fixed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "ignore": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Ignore"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why the finding is ignored, while it is; null otherwise."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The finding's page in the interface."
          }
        },
        "required": [
          "id",
          "project",
          "vulnerability_id",
          "aliases",
          "summary",
          "component",
          "severity",
          "cvss_score",
          "status",
          "exploitation",
          "introduced_via",
          "first_seen_at",
          "last_seen_at",
          "fixed_at",
          "ignore",
          "url"
        ]
      },
      "Reference": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "url"
        ]
      },
      "Event": {
        "type": "object",
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "type": "string",
            "enum": [
              "opened",
              "fixed",
              "reopened",
              "ignored",
