              "type": "string"
            },
            "description": "Versions of the package that fix the vulnerability."
          },
          "references": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Reference"
            }
          },
          "ignored_by": {
            "type": [
              "string",
              "null"
            ],
            "description": "The member who ignored the finding, while it is ignored."
