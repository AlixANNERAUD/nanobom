          },
          "modified": {
            "type": "string",
            "format": "date-time"
          },
          "cvss_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "cvss_vector": {
            "type": [
              "string",
              "null"
            ]
          },
          "fixed_versions": {
            "type": "array",
